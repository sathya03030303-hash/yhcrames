# =============================================================================
# yhcrames - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=yhcrames
APP_ENV=development                         # development | staging | production
APP_DEBUG=true                              # Enable debug mode (disable in production)
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=change-me-in-production          # Used for JWT signing and encryption
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Comma-separated allowed origins

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://yhcrames:yhcrames_dev@localhost:5432/yhcrames
DATABASE_SYNC_URL=postgresql://yhcrames:yhcrames_dev@localhost:5432/yhcrames
POSTGRES_USER=yhcrames
POSTGRES_PASSWORD=yhcrames_dev
POSTGRES_DB=yhcrames
POSTGRES_PORT=5432
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Production compose (docker/docker-compose.prod.yml) database roles ---
# NOSUPERUSER application roles (ADR-004). docker/postgres/init/02-app-role.sh
# creates them on a NEW data volume; the backend/workers then connect as
# APP_DB_USER and migrations run as OWNER_DB_USER. On an EXISTING volume (init
# scripts never re-run) leave both unset until they have been created by hand:
# see deploy/DEPLOYMENT_GUIDE.md "Upgrading an existing deployment".
APP_DB_USER=yhcrames_app
APP_DB_PASSWORD=change-me-app-role-password
OWNER_DB_USER=yhcrames_owner
OWNER_DB_PASSWORD=change-me-owner-role-password
# Dedicated key for the per-tenant reader-role login passwords (ADR-004): a
# random value distinct from every other secret (openssl rand -hex 32). Empty:
# derived from SECRET_KEY under a reader-only key (startup warns in production).
DB_READER_ROLE_SECRET=
# Caps on caller-SQL reader connections (ADR-004 sizing): per reader role, and
# concurrent per process.
# DB_READER_CONNECTION_LIMIT=10
# CALLER_SQL_MAX_CONCURRENCY=8
# The prod compose migrate step fails open by default (deploy/DEPLOYMENT_GUIDE.md
# 4a / 4b): a never-stamped create_all database is left unmigrated
# (MIGRATE_ON_UNSTAMPED=skip), and a failed `alembic upgrade head` of a stamped
# one is rolled back and logged with its repair (MIGRATE_ON_DRIFT=skip); either
# way the backend still starts. Set both to fail to make the deploy stop instead.
# MIGRATE_ON_UNSTAMPED=skip
# MIGRATE_ON_DRIFT=skip

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Celery (async task queue) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT Configuration ---
JWT_SECRET_KEY=change-me-in-production      # Separate secret for JWT tokens
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OIDC SSO (OpenID Connect) ---
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# --- SAML SSO ---
SAML_ENTITY_ID=yhcrames-sp
SAML_ACS_URL=http://localhost:8000/api/v1/saml/acs
SAML_SLO_URL=http://localhost:8000/api/v1/saml/slo

# --- Tenant ---
DEFAULT_TENANT_NAME=default
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-in-production
DEFAULT_ADMIN_EMAIL=admin@yhcrames.local

# --- AI Enricher API Keys ---
OPENAI_API_KEY=                             # OpenAI API key for AI enrichment
ANTHROPIC_API_KEY=                          # Anthropic API key for AI enrichment
AZURE_OPENAI_API_KEY=                       # Azure OpenAI key
AZURE_OPENAI_ENDPOINT=                      # Azure OpenAI endpoint URL

# --- Event Streaming (optional) ---
KAFKA_BOOTSTRAP_SERVERS=                    # e.g., localhost:9092
RABBITMQ_URL=                               # e.g., amqp://guest:guest@localhost:5672

# --- Email Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yhcrames.io
SMTP_USE_TLS=true

# --- Plugin Runtime ---
PLUGIN_RUNTIME_ENABLED=false
PLUGIN_DOCKER_NETWORK=yhcrames_plugins
PLUGIN_ALLOWED_IMAGE_PREFIXES=yhcrames/,docker.io/yhcrames/,ghcr.io/yhcrames/,localhost/,127.0.0.1/
PLUGIN_DEFAULT_TIMEOUT_SECONDS=30
PLUGIN_DEFAULT_MEMORY_LIMIT=256m
PLUGIN_DEFAULT_CPU_LIMIT=0.5

# --- Encryption ---
FERNET_KEY=change-me-in-production

# --- Logging ---
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                             # json | console

# --- Docker / Deployment ---
DOCKER_REGISTRY=ghcr.io/yhcrames           # Container registry URL
IMAGE_TAG=latest                            # Docker image tag
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- Flower (Celery monitoring) ---
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute               # Default API rate limit
RATE_LIMIT_BURST=200                        # Burst limit

# --- Observability ---
OTEL_ENABLED=false                          # Enable OpenTelemetry tracing (true/false)
OTEL_EXPORTER_ENDPOINT=http://localhost:4317  # OTLP gRPC collector endpoint (used when OTEL_ENABLED=true)
OTEL_EXPORTER_OTLP_ENDPOINT=               # OpenTelemetry collector endpoint (legacy)
PROMETHEUS_ENABLED=true                     # Enable Prometheus metrics endpoint

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=yhcrames
